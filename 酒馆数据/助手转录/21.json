ction resetTimer() {\n            clearInterval(timerInterval);\n            isRunning = false;\n            totalSeconds = (parseInt(document.getElementById('hours').value) || 0) * 3600 + \n                           (parseInt(document.getElementById('minutes').value) || 0) * 60 + \n                           (parseInt(document.getElementById('seconds').value) || 0);\n            \n            document.getElementById('message').textContent = '';\n            updateDisplay();\n        }\n\n        function showMessage(text, className) {\n            const msgElement = document.getElementById('message');\n            msgElement.textContent = text;\n            msgElement.className = 'message ' + className;\n        }\n\n        // 初始化显示\n        updateDisplay();\n    </script>\n</body>\n</html>\n</parameter>\n</function>\n</tool_call>"
